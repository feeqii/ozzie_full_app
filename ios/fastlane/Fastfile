require "dotenv"

env_file = File.expand_path("../.env.fastlane", __dir__)
env_local_file = File.expand_path("../.env.fastlane.local", __dir__)
Dotenv.overload(env_file) if File.exist?(env_file)
Dotenv.overload(env_local_file) if File.exist?(env_local_file)

def run_unbundled(command)
  Bundler.with_unbundled_env do
    sh(command)
  end
end

default_platform(:ios)

platform :ios do
  desc "One-time: create the App Store Connect app record"
  lane :bootstrap do |options|
    app_name = options[:app_name] || ENV["APP_NAME"]
    app_identifier = options[:app_identifier] || ENV["APP_IDENTIFIER"]
    app_sku = options[:app_sku] || ENV["APP_SKU"]

    ensure_env_vars(env_vars: %w[APPLE_ID])
    UI.user_error!("Missing APP_NAME. Set APP_NAME in .env.fastlane or pass app_name:") if app_name.to_s.strip.empty?
    UI.user_error!("Missing APP_IDENTIFIER. Set APP_IDENTIFIER in .env.fastlane or pass app_identifier:") if app_identifier.to_s.strip.empty?
    UI.user_error!("Missing APP_SKU. Set APP_SKU in .env.fastlane or pass app_sku:") if app_sku.to_s.strip.empty?

    begin
      produce(
        username: ENV["APPLE_ID"],
        app_name: app_name,
        app_identifier: app_identifier,
        sku: app_sku,
        language: "English",
        platform: "ios",
        skip_itc: false,
        skip_devcenter: false
      )
    rescue => e
      if e.message.include?("App Name you entered is already being used")
        UI.user_error!("APP_NAME '#{app_name}' is not unique in App Store Connect. Set a unique APP_NAME in .env.fastlane and rerun bootstrap.")
      end
      raise
    end
  end

  desc "Build Flutter IPA and upload to TestFlight"
  lane :upload_testflight do |options|
    build_name = options[:build_name] || ENV["BUILD_NAME"] || "1.0.0"
    build_number = options[:build_number] || ENV["BUILD_NUMBER"] || Time.now.strftime("%Y%m%d%H%M")
    app_identifier = options[:app_identifier] || ENV["APP_IDENTIFIER"] || "com.shafeeqmagdum.ozzie"
    asc_key_path = options[:asc_key_path] || ENV["ASC_KEY_PATH"]
    asc_key_content = options[:asc_key_content] || ENV["ASC_KEY_CONTENT"]

    ensure_env_vars(env_vars: %w[ASC_KEY_ID ASC_ISSUER_ID])

    if asc_key_path.to_s.strip.empty? && asc_key_content.to_s.strip.empty?
      UI.user_error!("Missing ASC key material. Set either ASC_KEY_PATH (preferred) or ASC_KEY_CONTENT.")
    end

    api_key = if !asc_key_path.to_s.strip.empty?
      app_store_connect_api_key(
        key_id: ENV["ASC_KEY_ID"],
        issuer_id: ENV["ASC_ISSUER_ID"],
        key_filepath: asc_key_path
      )
    else
      app_store_connect_api_key(
        key_id: ENV["ASC_KEY_ID"],
        issuer_id: ENV["ASC_ISSUER_ID"],
        key_content: asc_key_content,
        is_key_content_base64: ENV["ASC_KEY_IS_BASE64"] == "true"
      )
    end

    run_unbundled("cd .. && flutter clean")
    run_unbundled("cd .. && flutter pub get")
    run_unbundled("cd .. && flutter build ipa --release --build-name #{build_name} --build-number #{build_number} --export-method app-store")

    ipa_candidates = Dir[File.expand_path("../../build/ios/ipa/*.ipa", __dir__)]
    UI.user_error!("No IPA found in build/ios/ipa") if ipa_candidates.empty?
    ipa_path = ipa_candidates.max_by { |path| File.mtime(path) }

    upload_to_testflight(
      api_key: api_key,
      app_identifier: app_identifier,
      ipa: ipa_path,
      skip_waiting_for_build_processing: true,
      distribute_external: false
    )

    UI.success("Uploaded #{File.basename(ipa_path)} to TestFlight.")
  end
end
